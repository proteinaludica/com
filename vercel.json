{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "regions": [
    "dub1"
  ],
  "redirects": [
    {
      "source": "/criar",
      "destination": "https://criar.proteinaludica.com",
      "permanent": true
    },
    {
      "source": "/montra",
      "destination": "/catalogo#escritorio",
      "permanent": false
    },
    {
      "source": "/escolher",
      "destination": "/catalogo",
      "permanent": false
    },
    {
      "source": "/trabalho",
      "destination": "/catalogo#escritorio",
      "permanent": true
    }
  ]
}
